// A program that exercises every chart in the UI's DNA Visualizer tab.
// gene: AT-rich start, GC-rich middle, AT-rich end.
SEQUENCE gene      = "ATGAAATTATCAGCGGCCGCGGGCCCGCGCATGCGGCCATTTAAATATTAAGTTTAATAG";
SEQUENCE variant   = "ATGAAATTATCAGCGGCCGCTGGCCCGCGCATGCGGCCATTTAAATATCAAGTTTAATAG";
SEQUENCE truncated = "ATGAAATTATCAGCGGCCGCGGGCCCGCGCATGCGGCCATTTAAATATTAAGTTTA";

PRINT LENGTH(gene);
PRINT GC_CONTENT(gene);
FIND_MOTIF(gene, "ATG");
FIND_MOTIF(gene, "GCGG");
FIND_MOTIF(gene, "TTAA");
TRANSLATE(gene);

COMPARE gene WITH variant;
COMPARE gene WITH truncated;
